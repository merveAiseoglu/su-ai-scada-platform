# ==========================================
# Su-AI Environment Variables (Template)
# Do NOT commit your actual .env file!
# ==========================================

# --- Core Backend ---
# Secret key for JWT generation. Use a strong random string in production.
SECRET_KEY=your-strong-secret-key-here

# --- Database (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=merve-dev-password
POSTGRES_DB=su_ai
# Note: DATABASE_URL is constructed automatically in docker-compose.yml

# --- Vector DB (ChromaDB) ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# --- LLM Services ---
# If true, uses OpenAI first, then falls back to local Ollama
CLOUD_DEMO_MODE=true
# OpenAI API Key for cloud usage
OPENAI_API_KEY=sk-your-openai-api-key-here
# Local Ollama coordinates (managed by Docker)
OLLAMA_HOST=ollama
OLLAMA_PORT=11434

# --- API Security & Limits ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
AUTH_RATE_LIMIT=5/minute
GLOBAL_RATE_LIMIT=100/minute

# --- IoT / MQTT Broker ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# --- Notifications ---
FIREBASE_CREDENTIALS_PATH=path/to/firebase-credentials.json
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_RECIPIENTS=admin1@example.com,admin2@example.com